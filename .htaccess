# .htaccess in root (/webroots/813f8058/.htaccess)

# Security
<Files .env>
    Require all denied
</Files>

# Block database/export files from being served directly, regardless of location
<FilesMatch "\.(sqlite3?|db|sql|env)$">
    Require all denied
</FilesMatch>

# Prevent directory browsing
Options -Indexes

# UTF-8 encoding
AddDefaultCharset UTF-8

# Default file
DirectoryIndex index.php
